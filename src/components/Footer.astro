---
// src/components/Footer.astro
const year = new Date().getFullYear();
---
<footer class="bg-dark text-white pt-5 pb-3 mt-5">
  <div class="container">
    <div class="row g-4">
      <div class="col-md-4">
        <h5 class="text-warning mb-3">El Bodegón de las Baterías</h5>
        <p class="small text-light">Especialistas en energía automotriz. Ofrecemos calidad, rapidez y la mejor garantía para tu vehículo.</p>
      </div>
      <div class="col-md-4">
        <h5 class="mb-3">Horario de Atención</h5>
        <p class="small mb-1"><i class="bi bi-clock me-2"></i> Lunes a Viernes: 10:00 - 19:00</p>
        <p class="small"><i class="bi bi-clock me-2"></i> Sábados: 10:00 - 15:00</p>
      </div>
      <div class="col-md-4">
        <h5 class="mb-3">Contacto</h5>
        <p class="small mb-1"><i class="bi bi-geo-alt me-2"></i>Quilicura Av. O'Higgins #0337</p>
        <p class="small"><i class="bi bi-whatsapp me-2"></i> +56 9 2252 2593</p>
      </div>
    </div>
    <hr class="my-4 border-secondary" />
    <div class="text-center small text-secondary">
      &copy; {year} El Bodegón de las Baterías. Todos los derechos reservados.
    </div>
  </div>
</footer>