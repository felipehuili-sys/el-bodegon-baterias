---
// Definición de enlaces para la barra de navegación
const navLinks = [
  { nombre: "Inicio", url: "/" },
  { nombre: "Catálogo", url: "/catalogo" },
  { nombre: "Servicios", url: "/servicios" },
  { nombre: "Preguntas Frecuentes", url: "/preguntas" },
  { nombre: "Contacto", url: "/contacto" },
];

const pathname = Astro.url.pathname;
---

<nav class="navbar navbar-expand-lg navbar-dark bg-primary sticky-top shadow-sm">
  <div class="container">
    <!-- Logotipo -->
    <a class="navbar-brand d-flex align-items-center fw-bold" href="/">
      <img 
        src="/bodegon.png" 
        alt="El Bodegón Baterías" 
        height="40"
        width="40"
        class="d-inline-block align-text-top me-2 rounded-circle"
        style="object-fit: cover;"
        onerror="this.style.display='none'"
      />
      <span>El Bodegón Baterías</span>
    </a>

    <!-- Botón responsive para móviles -->
    <button 
      class="navbar-toggler border-0" 
      type="button" 
      data-bs-toggle="collapse" 
      data-bs-target="#navbarNav" 
      aria-controls="navbarNav" 
      aria-expanded="false" 
      aria-label="Toggle navigation"
    >
      <span class="navbar-toggler-icon"></span>
    </button>

    <!-- Menú -->
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
        {navLinks.map((link) => {
          const isActive = pathname === link.url || (link.url !== "/" && pathname.startsWith(link.url));
          return (
            <li class="nav-item">
              <a 
                class={`nav-link fw-semibold px-3 ${isActive ? 'active text-warning' : ''}`} 
                href={link.url}
              >
                {link.nombre}
              </a>
            </li>
          );
        })}
        
        <!-- Botón rápido de Cotización -->
        <li class="nav-item ms-lg-2 mt-2 mt-lg-0">
          <a 
            href="https://wa.me/56922522593?text=Hola,%20quisiera%20cotizar%20una%20batería" 
            target="_blank" 
            class="btn btn-warning fw-bold btn-sm px-3 rounded-pill" style="color: #212223c4">
            <i class="bi bi-whatsapp me-1"></i> Solicitar cotización
          </a>
        </li>
      </ul>
    </div>
  </div>
</nav>
