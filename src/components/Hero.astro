---
// src/components/Hero.astro
---
<section class="bg-light py-5 border-bottom" id="inicio">
  <div class="container my-4">
    <div class="row align-items-center">
      <div class="col-lg-7">
        <span class="badge bg-danger mb-2">Servicio Rápido y Garantizado</span>
        <h1 class="display-4 fw-bold">¿Tu vehículo no arranca? Cambiamos tu batería hoy.</h1>
        <p class="lead my-3 text-secondary">
          Venta, diagnóstico e instalación de baterías para todo tipo de vehículos.
        </p>
        <div class="d-flex gap-2">
          <a href="#catalogo" class="btn btn-primary btn-lg">Ver Baterías</a>
          <a href="tel:+123456789" class="btn btn-outline-secondary btn-lg">
            <i class="bi bi-telephone-fill"></i> Llamar Directo
          </a>
        </div>
      </div>
      <div class="col-lg-5 text-center mt-4 mt-lg-0">
        <div class="p-4 bg-white shadow rounded-3 border">
          <i class="bi bi-car-front-fill text-primary display-1"></i>
          <h3 class="h4 mt-3">Diagnóstico Gratis</h3>
          <p class="text-muted small">Te probamos el estado del alternador y la batería.</p>
        </div>
      </div>
    </div>
  </div>
</section>