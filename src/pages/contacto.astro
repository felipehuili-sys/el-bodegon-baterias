---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Redes y canales de contacto directo
const canalesContacto = [
  {
    titulo: "WhatsApp Directo",
    descripcion: "Respuesta inmediata para emergencias y cotizaciones.",
    icono: "bi-whatsapp",
    color: "bg-success text-white",
    btnColor: "btn-success",
    link: "https://wa.me/56922522593?text=Hola,%20quisiera%20hacer%20una%20consulta",
    textoBtn: "Escribir al WhatsApp"
  },
  {
    titulo: "Instagram",
    descripcion: "Mira nuestros tips y promociones.",
    icono: "bi-instagram",
    color: "bg-danger text-white",
    btnColor: "btn-outline-danger",
    link: "https://www.instagram.com/bodegondebaterias/",
    textoBtn: "Seguir en Instagram"
  },
  {
    titulo: "Facebook",
    descripcion: "Visita nuestro Facebook y revisa nuestras opiniones.",
    icono: "bi-facebook",
    color: "bg-primary text-white",
    btnColor: "btn-outline-primary",
    link: "https://www.facebook.com/profile.php?id=61589493285589",
    textoBtn: "Ver en Facebook"
  }
];

// Reemplaza esta URL con el enlace exacto de tu negocio en Google Maps
const urlGoogleMaps = "https://maps.app.goo.gl/g5xKNWUCJiS8JWnG7"; 
---

<Layout title="Contacto - El Bodegón Baterías">
  <Navbar />

  <main class="container my-5">
    
    <!-- Encabezado -->
    <div class="text-center mb-5">
      <h1 class="display-5 fw-bold text-primary">Ponte en Contacto</h1>
      <p class="lead text-muted">
        Estamos listos para atenderte. Comunícate a través de nuestras redes sociales o visítanos directamente.
      </p>
    </div>

    <!-- Redes Sociales y Canales Principales -->
    <section class="mb-5">
      <div class="row g-4">
        {canalesContacto.map((canal) => (
          <div class="col-md-4">
            <div class="card h-100 shadow-sm border-0 text-center p-4">
              <div class="card-body d-flex flex-column justify-content-between">
                <div>
                  <div class={`rounded-circle d-inline-flex align-items-center justify-content-center mb-3 ${canal.color}`} style="width: 70px; height: 70px;">
                    <i class={`bi ${canal.icono} fs-1`}></i>
                  </div>
                  <h2 class="h4 card-title fw-bold mb-2">{canal.titulo}</h2>
                  <p class="card-text text-secondary mb-4">{canal.descripcion}</p>
                </div>
                <div>
                  <a 
                    href={canal.link} 
                    class={`btn ${canal.btnColor} w-100 fw-bold`}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <i class={`bi ${canal.icono} me-2`}></i> {canal.textoBtn}
                  </a>
                </div>
              </div>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Información de Ubicación y Formulario -->
    <div class="row g-4 align-items-stretch">
      
      <!-- Datos del Taller con Link Clicable a Google Maps -->
      <div class="col-lg-5">
        <div class="card h-100 shadow-sm border-0 bg-light p-4">
          <h2 class="h3 fw-bold text-primary mb-4">Información del local</h2>
          
          <!-- SECCIÓN DE DIRECCIÓN INTERACTIVA -->
          <div class="mb-4">
            <a 
              href={urlGoogleMaps} 
              target="_blank" 
              rel="noopener noreferrer" 
              class="text-decoration-none text-dark d-flex align-items-start p-2 rounded border bg-white shadow-sm hover-effect"
            >
              <div class="bg-primary text-white p-3 rounded me-3">
                <i class="bi bi-geo-alt fs-4"></i>
              </div>
              <div class="flex-grow-1">
                <div class="d-flex justify-content-between align-items-center">
                  <h3 class="h6 fw-bold mb-1 text-primary">Dirección (Ver en Mapa):</h3>
                  <i class="bi bi-box-arrow-up-right text-primary small"></i>
                </div>
                <p class="text-secondary fw-bold m-0">Av. O'Higgins #0337, Quilicura</p>
                <small class="text-muted">(Haz clic aquí para abrir Google Maps)</small>
              </div>
            </a>
          </div>

          <!-- Horarios -->
          <div class="d-flex align-items-start mb-4">
            <div class="bg-primary text-white p-3 rounded me-3">
              <i class="bi bi-clock fs-4"></i>
            </div>
            <div>
              <h3 class="h6 fw-bold mb-1">Horarios de Atención:</h3>
              <p class="text-secondary m-0 mb-1"><strong>Lunes a Viernes:</strong> 10:00 hrs - 19:00 hrs</p>
              <p class="text-secondary m-0"><strong>Sábados:</strong> 10:00 hrs - 15:00 hrs</p>
            </div>
          </div>

          <!-- Teléfonos -->
          <div class="d-flex align-items-start">
            <div class="bg-primary text-white p-3 rounded me-3">
              <i class="bi bi-telephone fs-4"></i>
            </div>
            <div>
              <h3 class="h6 fw-bold mb-1">Teléfonos de Atención:</h3>
              <p class="text-secondary m-0">+56 9 2252 2593 (Ventas)</p>
              <p class="text-secondary m-0">+56 2 2252 2593 (Mesa Central Taller)</p>
            </div>
          </div>
        </div>
      </div>

      <!-- Formulario de Mensaje por WhatsApp -->
      <div class="col-lg-7">
        <div class="card h-100 shadow-sm border-0 p-4">
          <h2 class="h3 fw-bold text-primary mb-3">Envíanos un Mensaje por WhatsApp</h2>
          <p class="text-muted mb-4">Ingresa tus datos y al hacer clic te redirigiremos a WhatsApp con la información lista para enviar.</p>
          
          <form id="whatsappForm">
            <div class="row g-3">
              <div class="col-md-6">
                <label for="nombre" class="form-label fw-bold">Nombre Completo</label>
                <input type="text" class="form-control" id="nombre" placeholder="Ej: Juan Pérez" required />
              </div>
              <div class="col-md-6">
                <label for="telefono" class="form-label fw-bold">Teléfono de Contacto</label>
                <input type="tel" class="form-control" id="telefono" placeholder="+56 9 ..." required />
              </div>
              <div class="col-12">
                <label for="vehiculo" class="form-label fw-bold">Vehículo (Marca, Modelo, Año)</label>
                <input type="text" class="form-control" id="vehiculo" placeholder="Ej: Toyota Hilux 2020" />
              </div>
              <div class="col-12">
                <label for="mensaje" class="form-label fw-bold">¿En qué te podemos ayudar?</label>
                <textarea class="form-control" id="mensaje" rows="4" placeholder="Ej: Necesito cotizar una batería de 60Ah o consultar por la reparación del motor de partida..." required></textarea>
              </div>
              <div class="col-12 mt-4">
                <button type="submit" class="btn btn-success btn-lg w-100 fw-bold">
                  <i class="bi bi-whatsapp me-2"></i> Enviar Mensaje por WhatsApp
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>

    </div>

  </main>

  <Footer />
</Layout>

<!-- SCRIPT PARA ENVIAR EL FORMULARIO A WHATSAPP -->
<script>
  const form = document.getElementById('whatsappForm');

  form?.addEventListener('submit', (e) => {
    e.preventDefault();

    const numeroTelefono = "56922522593";
    const nombre = (document.getElementById('nombre') as HTMLInputElement).value;
    const telefono = (document.getElementById('telefono') as HTMLInputElement).value;
    const vehiculo = (document.getElementById('vehiculo') as HTMLInputElement).value || "No especificado";
    const mensaje = (document.getElementById('mensaje') as HTMLTextAreaElement).value;

    const textoMensaje = `*NUEVO CONTACTO DESDE LA WEB*%0A%0A` +
      `*Nombre:* ${encodeURIComponent(nombre)}%0A` +
      `*Teléfono:* ${encodeURIComponent(telefono)}%0A` +
      `*Vehículo:* ${encodeURIComponent(vehiculo)}%0A` +
      `*Consulta:* ${encodeURIComponent(mensaje)}`;

    const urlWhatsApp = `https://wa.me/${numeroTelefono}?text=${textoMensaje}`;
    window.open(urlWhatsApp, '_blank');
  });
</script>