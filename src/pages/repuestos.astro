---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Catálogo de Alternadores y Motores de Partida
const productos = [
  {
    id: "alt-mitsubishi-12v",
    tipo: "Alternador",
    titulo: "Alternador Mitsubishi 12V 90A",
    marca: "Mitsubishi / Mando",
    precio: "$115.000",
    garantia: "Garantía 1 año",
    estado: "Nuevo Original",
    destacado: "Alta Duración",
    aplicacion: "Suzuki Swift, Hyundai Accent, Kia Rio",
    icono: "bi-lightning-charge-fill",
    badgeColor: "bg-primary"
  },
  {
    id: "mp-bosch-12v",
    tipo: "Motor de Partida",
    titulo: "Motor de Partida Bosch 12V",
    marca: "Bosch",
    precio: "$89.900",
    garantia: "Garantía 1 año",
    estado: "Potencia Heavy Duty",
    destacado: "Reconstruido Certificado",
    aplicacion: "Toyota RAV4, Chevrolet Sail, Nissan Versa",
    icono: "bi-gear-wide-connected",
    badgeColor: "bg-dark"
  },
  {
    id: "alt-valeo-120a",
    tipo: "Alternador",
    titulo: "Alternador Valeo 12V 120A",
    marca: "Valeo",
    precio: "$135.000",
    garantia: "Garantía 1 año",
    estado: "Carga Reforzada",
    destacado: "Ideal para SUVs / Diésel",
    aplicacion: "Peugeot 308, Citroën C4, Renault Duster",
    icono: "bi-lightning-charge-fill",
    badgeColor: "bg-primary"
  },
  {
    id: "mp-denso-12v",
    tipo: "Motor de Partida",
    titulo: "Motor de Partida Denso Heavy",
    marca: "Denso",
    precio: "$95.000",
    garantia: "Garantía 1 año",
    estado: "Alto Torque",
    destacado: "Nuevo Certificado",
    aplicacion: "Mitsubishi L200, Nissan Navara, Toyota Hilux",
    icono: "bi-gear-wide-connected",
    badgeColor: "bg-dark"
  },
  {
    id: "alt-delco-24v",
    tipo: "Alternador",
    titulo: "Alternador Delco Remy 24V 80A",
    marca: "Delco Remy",
    precio: "$160.000",
    garantia: "Garantía 1 año",
    estado: "Línea Pesada 24V",
    destacado: "Resistencia Extrema",
    aplicacion: "Camiones, Buses y Maquinaria Pesada",
    icono: "bi-lightning-charge-fill",
    badgeColor: "bg-warning text-dark"
  },
  {
    id: "mp-prestolite-24v",
    tipo: "Motor de Partida",
    titulo: "Motor de Partida 24V Camión",
    marca: "Prestolite / Mahle",
    precio: "$145.000",
    garantia: "Garantía 1 año",
    estado: "Arranque Pesado 24V",
    destacado: "Uso Continuo Taller",
    aplicacion: "Camiones Mercedes-Benz, Volvo, Cargo",
    icono: "bi-gear-wide-connected",
    badgeColor: "bg-warning text-dark"
  }
];
---

<Layout title="Catálogo de Alternadores y Motores de Partida - El Bodegón">
  <Navbar />

  <main class="container my-5 py-md-3">
    
    <!-- Encabezado de la Página -->
    <div class="text-center max-w-2xl mx-auto mb-5">
      <span class="badge bg-primary bg-opacity-10 text-primary fw-bold text-uppercase px-3 py-2 rounded-pill mb-2">
        <i class="bi bi-tools me-1"></i> Electromecánica y Recambios
      </span>
      <h1 class="display-5 fw-bold text-primary">Catálogo de Alternadores y Motores de Partida</h1>
      <p class="lead text-muted">
        Encuentra el repuesto exacto para tu vehículo con garantía y prueba en banco de ensayo.
      </p>
    </div>

    <!-- Grilla de Productos estilo Catálogo -->
    <div class="row g-4 justify-content-center">
      {productos.map((item) => (
        <div class="col-md-6 col-lg-4" id={item.id}>
          <div class="card h-100 border-2 border-primary border-opacity-25 shadow-sm rounded-4 p-3 bg-white hover-shadow transition">
            <div class="card-body d-flex flex-column justify-content-between p-2">
              
              <div>
                <!-- Badge Superior y Tipo -->
                <div class="d-flex align-items-center justify-content-between mb-3">
                  <span class="fw-bold text-uppercase text-primary small tracking-wider">{item.tipo}</span>
                  <span class={`badge ${item.badgeColor} rounded-pill px-3 py-1 text-white`}>{item.marca}</span>
                </div>

                <!-- Título -->
                <h3 class="h5 fw-bold text-dark text-center mb-3">{item.titulo}</h3>

                <!-- Contenedor Visual del Repuesto -->
                <div class="bg-light rounded-4 p-4 text-center mb-3 position-relative d-flex align-items-center justify-content-center" style="min-height: 140px;">
                  <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-3 d-inline-flex">
                    <i class={`bi ${item.icono} display-4`}></i>
                  </div>
                </div>

                <!-- Lista de Especificaciones con Checkmarks -->
                <ul class="list-unstyled mb-4 small">
                  <li class="mb-2 d-flex align-items-center text-dark fw-semibold">
                    <i class="bi bi-check-circle-fill text-warning me-2 fs-6"></i>
                    {item.garantia}
                  </li>
                  <li class="mb-2 d-flex align-items-center text-dark">
                    <i class="bi bi-check-circle-fill text-warning me-2 fs-6"></i>
                    {item.estado}
                  </li>
                  <li class="mb-2 d-flex align-items-center text-dark">
                    <i class="bi bi-check-circle-fill text-warning me-2 fs-6"></i>
                    {item.destacado}
                  </li>
                  <li class="mt-3 pt-2 border-top text-muted">
                    <strong class="text-dark">Aplica a:</strong> {item.aplicacion}
                  </li>
                </ul>
              </div>

              <!-- Precio y Botón WhatsApp -->
              <div class="pt-2">
                <div class="text-center mb-3">
                  <span class="display-6 fw-bold text-dark">{item.precio}</span>
                  <small class="d-block text-muted fs-7">(Incluye revisión/instalación en taller)</small>
                </div>

                <a 
                  href={`https://wa.me/56922522593?text=Hola,%20busco%20cotizar%20el%20repuesto:%20${encodeURIComponent(item.titulo)}`}
                  target="_blank"
                  class="btn btn-primary w-100 fw-bold py-2 rounded-3 shadow-sm d-flex align-items-center justify-content-center gap-2"
                >
                  <i class="bi bi-whatsapp fs-5"></i> Cotizar por WhatsApp
                </a>
              </div>

            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Banner Inferior de Asesoría -->
    <div class="bg-primary text-white rounded-4 p-4 p-md-5 mt-5 text-center shadow">
      <h3 class="fw-bold mb-2">¿DUDAS TÉCNICAS?</h3>
      <p class="mb-4 opacity-90">Envía el modelo y año de tu auto por WhatsApp para verificar compatibilidad exacta.</p>
      <a 
        href="https://wa.me/56922522593?text=Hola,%20necesito%20saber%20qué%20alternador/motor%20de%20partida%20usa%20mi%20auto" 
        target="_blank" 
        class="btn btn-warning text-dark fw-bold btn-lg px-4 rounded-pill shadow"
      >
        <i class="bi bi-whatsapp me-2"></i> Consultar a un Técnico
      </a>
    </div>

  </main>

  <Footer />
</Layout>