---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

// Servicios detallados del local
const serviciosEspecializados = [
  {
    id: "motores-partida",
    titulo: "Reparación de Motores de Partida",
    subtitulo: "Autos, Camionetas y Camiones",
    icono: "bi-gear-wide-connected",
    badge: "Local Especializado",
    badgeColor: "bg-primary",
    descripcion: "Realizamos un diagnóstico integral del sistema de arranque. Desmontamos, limpiamos y reemplazamos los componentes desgastados para restablecer su correcto funcionamiento.",
    caracteristicas: [
      "Cambio de carbones, bendix, automático o solenoide ",
      "Prueba en banco de ensayo antes de montar",
      "Sistemas de 12V y 24V (Camiones y maquinaria)"
    ]
  },
  {
    id: "alternadores",
    titulo: "Mantención y Reparación de Alternadores",
    subtitulo: "Restauración del Sistema de Carga",
    icono: "bi-lightning-charge",
    badge: "Garantizado",
    badgeColor: "bg-info text-light",
    descripcion: "Si el sistema de carga presenta fallas, reparamos su alternador para asegurar que la batería reciba el voltaje adecuado durante la conducción.",
    caracteristicas: [
      "Cambio de caja reguladora y placa rectificadora",
      "Reemplazo de rodamientos y poleas libre/fija",
      "Medición de amperes de salida reales"
    ]
  },
  {
    id: "diagnostico",
    titulo: "Diagnóstico Eléctrico y Mediciones",
    subtitulo: "Evaluación Preventiva",
    icono: "bi-speedometer2",
    badge: "Sin costo en local",
    badgeColor: "bg-success",
    descripcion: "Evaluamos el estado de su sistema mediante instrumentos digitales e identificamos consumos anómalos que puedan descargar la batería.",
    caracteristicas: [
      "Test de vida útil de la batería (CCA)",
      "Prueba de carga del alternador bajo consumo",
      "Detección de parásitos eléctricos"
    ]
  }
];
---

<Layout title="Servicios Técnicos - El Bodegón Baterías">
  <Navbar />

  <main class="container my-5">
    
    <!-- Encabezado -->
    <div class="text-center mb-5">
      <h1 class="display-5 fw-bold text-primary">Servicios Técnicos y Especializados</h1>
      <p class="lead text-muted">
        Especialistas en electromecánica: Baterías, Motores de Partida y Alternadores para todo tipo de vehículos.
      </p>
    </div>

    <!-- Lista de Servicios (Alineación ordenada en 3 columnas para que queden simétricas) -->
    <div class="row g-4 justify-content-center">
      {serviciosEspecializados.map((servicio) => (
        <div class="col-md-6 col-lg-4" id={servicio.id}>
          <div class="card h-100 shadow-sm border-0 bg-light p-3 p-xl-4">
            <div class="card-body d-flex flex-column justify-content-between">
              <div>
                <!-- Encabezado de la Tarjeta -->
                <div class="d-flex align-items-center justify-content-between mb-3">
                  <div class="d-flex align-items-center">
                    <div class="bg-primary text-white p-3 rounded-circle me-3 flex-shrink-0">
                      <i class={`bi ${servicio.icono} fs-3`}></i>
                    </div>
                    <div>
                      <h2 class="h5 card-title mb-0 fw-bold text-dark">{servicio.titulo}</h2>
                      <small class="text-muted fw-semibold d-block">{servicio.subtitulo}</small>
                    </div>
                  </div>
                </div>

                <div class="mb-3">
                  <span class={`badge ${servicio.badgeColor}`}>{servicio.badge}</span>
                </div>

                <p class="card-text text-secondary mb-4 small">
                  {servicio.descripcion}
                </p>

                <!-- Puntos Clave del Servicio -->
                <h3 class="h6 fw-bold text-dark mb-2">Alcance del servicio</h3>
                <ul class="list-unstyled text-muted small mb-4">
                  {servicio.caracteristicas.map((item) => (
                    <li class="mb-2 d-flex align-items-start">
                      <i class="bi bi-check-circle-fill text-success me-2 mt-1"></i>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Botón de Acción -->
              <div class="pt-3 border-top mt-2">
                <a 
                  href={`https://wa.me/56922522593?text=Hola,%20quisiera%20agendar/consultar%20por%20el%20servicio:%20${encodeURIComponent(servicio.titulo)}`}
                  class="btn btn-success w-100 fw-bold"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <i class="bi bi-whatsapp me-2"></i> Solicitar atención
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Banner Informativo Local -->
    <div class="bg-primary text-white rounded-3 p-4 p-md-5 mt-5 text-center shadow">
      <h2 class="fw-bold mb-3">¿Requiere servicio para camiones o maquinaria pesada?</h2>
      <p class="lead mb-4">Atendemos requerimientos empresariales, revisión de bancos de baterías y mantenimiento de motores de partida de 24 V.</p>
      <a 
        href="https://wa.me/56922522593?text=Hola,%20necesito%20cotizacion%20para%20flota%20o%20maquinaria" 
        class="btn btn-warning btn-lg fw-bold text- light"
        target="_blank"
      >
        <i class="bi bi-telephone-outbound me-2"></i> Solicitar atención corporativa
      </a>
    </div>

  </main>

  <Footer />
</Layout>
